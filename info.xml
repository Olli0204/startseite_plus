<?xml version="1.0" encoding="utf-8"?>
<jtlshopplugin>
    <Name>Startseite Plus</Name>
    <Description>Ansprechende OPC-Bausteine für die Startseite: Hero-Slider, Kategorie-Kacheln, Überschriften, Vorteils-Leiste, Aktions-Banner mit Countdown und Text-Bild-Sektion</Description>
    <Author>Oliver Kamps</Author>
    <URL>https://ollipolli.de</URL>
    <XMLVersion>102</XMLVersion>
    <MinShopVersion>5.5.1</MinShopVersion>
    <MaxShopVersion>5.8.0</MaxShopVersion>
    <PluginID>startseite_plus</PluginID>
    <Version>2.0.1</Version>
    <CreateDate>2025-06-23</CreateDate>
    <Install>
        <Portlets>
            <Portlet>
                <Title>Hero-Slider</Title>
                <Class>sliderPlus</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Überschrift Plus</Title>
                <Class>headingPlus</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Kategorie-Kacheln</Title>
                <Class>pictureBox</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Vorteile-Leiste</Title>
                <Class>uspBar</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Aktions-Banner</Title>
                <Class>promoBanner</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Text und Bild</Title>
                <Class>textImage</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
        </Portlets>
        <PortletInputTypes>
            <PortletInputType>
                <Name>repeater</Name>
            </PortletInputType>
        </PortletInputTypes>
    </Install>
</jtlshopplugin>
