<?xml version="1.0" encoding="utf-8"?>
<jtlshopplugin>
    <Name>Startseite Plus</Name>
    <Description>Ansprechende OPC-Bausteine für die Startseite: Hero-Slider, Kategorie-Kacheln, Überschriften, Vorteils-Leiste, Aktions-Banner mit Countdown, Deal-Banner für Kupon- und Bundle-Aktionen und Text-Bild-Sektion; zentrale Countdown-Verwaltung für Banner und Artikelseiten; versteckte Newsletter-Deal-Seiten auf Deutsch und Englisch (Artikelliste mit Deal-Preisen, Set-Preisen und Code, nur per geheimem Link)</Description>
    <Author>Oliver Kamps</Author>
    <URL>https://ollipolli.de</URL>
    <XMLVersion>102</XMLVersion>
    <MinShopVersion>5.5.1</MinShopVersion>
    <MaxShopVersion>5.8.1</MaxShopVersion>
    <PluginID>startseite_plus</PluginID>
    <Version>2.13.1</Version>
    <CreateDate>2025-06-23</CreateDate>
    <Install>
        <Adminmenu>
            <Customlink sort="1">
                <Name>Countdowns</Name>
            </Customlink>
            <Customlink sort="2">
                <Name>Newsletter-Deals</Name>
            </Customlink>
        </Adminmenu>
        <Portlets>
            <Portlet>
                <Title>Hero-Slider</Title>
                <Class>sliderPlus</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Überschrift Plus</Title>
                <Class>headingPlus</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Kategorie-Kacheln</Title>
                <Class>pictureBox</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Vorteile-Leiste</Title>
                <Class>uspBar</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Aktions-Banner</Title>
                <Class>promoBanner</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Text und Bild</Title>
                <Class>textImage</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
            <Portlet>
                <Title>Deal-Banner</Title>
                <Class>dealBanner</Class>
                <Group>Startseite Plus</Group>
                <Active>1</Active>
            </Portlet>
        </Portlets>
        <PortletInputTypes>
            <PortletInputType>
                <Name>repeater</Name>
            </PortletInputType>
            <PortletInputType>
                <Name>productpicker</Name>
            </PortletInputType>
            <PortletInputType>
                <Name>couponpicker</Name>
            </PortletInputType>
        </PortletInputTypes>
    </Install>
</jtlshopplugin>
